# Choose the LLM provider used by qaforge plan/generate/heal/ask.
# Supported: anthropic, openai, codex, gemini, openai-compatible
QAFORGE_LLM_PROVIDER=codex
QAFORGE_MODEL=gpt-5.2-codex

# Add the API key for your selected provider.
# codex/openai/openai-compatible use OPENAI_API_KEY.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:11434/v1

# Demo target app for the MVP.
BASE_URL=https://www.saucedemo.com
